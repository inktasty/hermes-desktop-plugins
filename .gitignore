verify/*.plugin.js
verify/*.plugin.*.js
# scratch copies the probes generate and import (e.g. verify/opencode-usage.e2e.gen.js)
verify/*.gen.js
# Only the five tracked stub files under verify/node_modules ship; a real npm install
# anywhere (notably verify/) must never be swept into a commit.
#
# `node_modules/` with no slash matches at ANY depth, so nested trees are covered.
# Everything inside verify/node_modules is then excluded, and each stub file is
# re-included by its EXACT path: every parent must be re-included first, because git
# will not look inside an excluded directory, and re-including a whole tree with `**`
# would let a real install inside a stub directory through again.
node_modules/
!verify/node_modules/
verify/node_modules/**
!verify/node_modules/@hermes/
!verify/node_modules/@hermes/plugin-sdk/
!verify/node_modules/@hermes/plugin-sdk/index.js
!verify/node_modules/@hermes/plugin-sdk/package.json
!verify/node_modules/react/
!verify/node_modules/react/index.js
!verify/node_modules/react/jsx-runtime.js
!verify/node_modules/react/package.json
*.zip
# local dated backups, worktrees and byte-code are never part of a release
*.bak-*
.worktrees/
__pycache__/
*.pyc
